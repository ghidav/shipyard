# Copy to `.env` in the directory you run from, and uncomment what you use.
# Every line is commented on purpose: an uncommented `KEY=` still sets KEY, to nothing.
# A variable already set in the shell wins over the file; a key assigned twice keeps the
# last one.

# A model served from Tinker
# TINKER_API_KEY=
# Another server that speaks the Tinker API, for every model that names none; unset: Thinking
# Machines' Tinker
# TINKER_BASE_URL=
# A model that names its own server, [models.<role>] base_url, names the variable that holds
# that server's key as api_key_env, such as:
# SPINDLE_API_KEY=

# Modal, where the recipes run their trials: these two, unless its CLI holds a login
# (`uvx modal setup`)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional: the proxy fetches the model's tokenizer from Hugging Face
# HF_TOKEN=

# Together: a model on its post-training, [models.<role>] provider = "together", and
# trials in its sandboxes, [rollout] sandbox = "together"
# TOGETHER_API_KEY=

# A model its provider serves: [models.<role>] provider, such as a recipe's reflector
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Other sandboxes: only the ones you use; Harbor reads these. Beam and Blaxel also take their
# own CLI's login, and Daytona a JWT with an organization id.
# DAYTONA_API_KEY=
# E2B_API_KEY=
# RUNLOOP_API_KEY=
# BEAM_TOKEN=
# BL_WORKSPACE=
# BL_API_KEY=

# The proxy's two tokens; unset, each run makes its own. Never in [agent] env.
# HARNESS_PROXY_TOKEN=
# HARNESS_PROXY_CONTROL_TOKEN=

# Where runs live; unset: ./runs
# SHIPYARD_RUNS=

# A blueprint with [logging.wandb]: its key, unless `wandb login` holds one
# WANDB_API_KEY=
